; Engine configuration file.
; 《無盡軍勢：荒原遠征》— Godot 4.6
config_version=5

[application]

config/name="Infinite Legion: Wildland Expedition"
config/description="無限程序草原上的雙語動作戰鬥、軍隊養成與蟒皇世界 Boss 遠征。 Bilingual action combat, army building, castle conquest, and a Python Emperor world boss across an infinite procedural wildland."
run/main_scene="res://main.tscn"
config/icon="res://assets/app/app_icon.png"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.055, 0.075, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

# Touch has a complete ScreenTouch/ScreenDrag path in main.gd. Disabling the
# compatibility mouse event prevents one tap from selecting a class and then
# immediately activating an unrelated gameplay button.
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)

[audio]

driver/enable_input=false
